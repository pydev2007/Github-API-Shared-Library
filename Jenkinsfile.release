@Library("YOUR SHARED LIBRARY") _

pipeline {
    agent any
    stages {
        stage('Release') {
            steps {
                script {
                    def config = readYaml text: libraryResource('repos.yaml')

                    def actions = ['None', 'Major', 'Minor', 'Patch']

                    // Start input
                    def parameters = config.repos.collect { repo ->
                        choice(
                            name: repo,
                            choices: actions.join('\n'),
                            description: "Action for ${repo}"
                        )
                    }

                    Map<String, String> selections = input(
                        message: 'Select actions',
                        parameters: parameters
                    )

                    releaseLog = ''

                    selections.each { repoName, action ->

                        def release = git.gitRepo(
                            owner: "ORG NAME",
                            repo: repoName,
                            path: "releases/latest"
                        )

                        def version = release.tag_name
                                      .drop(1)
                                      .tokenize(".")
                                      .collect { it.toInteger() }

                        switch(action) {
                            case "Major":
                                echo "Major release"
                                version[0] += 1
                                version[1] = 0
                                version[2] = 0
                                echo "${git.createRelease(repoName, version)}"
                                releaseLog += "${repoName}\n${release.tag_name} -> v${version.join('.')}  \n\n"

                            case "Minor":
                                echo "Minor release"
                                version[1] += 1
                                version[2] = 0
                                echo "${git.createRelease(repoName, version)}"
                                releaseLog += "${repoName}\n${release.tag_name} -> v${version.join('.')}  \n\n"

                            case "Patch":
                                echo "Patch release"
                                version[2] += 1
                                echo "${git.createRelease(repoName, version)}"
                                releaseLog += "${repoName}\n${release.tag_name} -> v${version.join('.')}  \n\n"
                            default:
                                echo "No release needed. Skipping"
                        }
                        echo "${repoName} release ${version}"


                    }

                    echo releaseLog

                    echo "Action map: ${selections}"

                }

                writeFile(file: 'Releaselog.txt', text: releaseLog)
                archiveArtifacts artifacts: 'Releaselog.txt'

                }
            }
        }
    }
    post {
        success {
            emailext(
                subject: "SUCCESS - Release Pipeline",
                mimeType: "text/html",
                attachmentsPattern: "Releaselog.txt",
                to: "YOUR EMAIL",
                body: "<h2>SUCCESS - Release Pipeline</h2>")
            cleanWs()
        }
    }
}
