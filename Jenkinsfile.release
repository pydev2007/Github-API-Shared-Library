@Library("YOUR SHARED LIBRARY") _

pipeline {
    agent any
    stages {
        stage('Release') {
            steps {
                script {
                    def config = readYaml text: libraryResource('repos.yaml')

                    def actions = ['None', 'Major', 'Minor', 'Patch']

                    // Start input
                    def parameters = config.repos.collect { repo ->
                        choice(
                            name: repo,
                            choices: actions.join('\n'),
                            description: "Action for ${repo}"
                        )
                    }

                    Map<String, String> selections = input(
                        message: 'Select actions',
                        parameters: parameters
                    )

                    selections.each { repoName, action ->
                        def release = git.gitRepo(
                            owner: "bindustries",
                            repo: repoName,
                            path: "releases/latest"
                        )
                        def version = release.tag_name
                                      .drop(1)
                                      .tokenize(".")
                                      .collect { it.toInteger() }

                        if (action == "Major") {
                            echo "Major release"
                            version[0] += 1
                            version[1] = 0
                            version[2] = 0
                            echo "${git.createRelease(repoName, version)}"
                        }
                        else if (action == "Minor") {
                            echo "Minor release"
                            version[1] += 1
                            version[2] = 0
                            echo "${git.createRelease(repoName, version)}"
                        }
                        else if (action == "Patch") {
                            echo "Patch release"
                            version[2] += 1
                            echo "${git.createRelease(repoName, version)}"
                        }
                        else if (action == "None") {
                            echo "No release needed. Skipping"
                        }
                        echo "${repoName} release ${version}"
                    }
                }
            }
        }
    }
}
